<mxfile><diagram name="teleop-free-architecture"><mxGraphModel dx="1500" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1080" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title" value="Teleop-Free 数据引擎：决策流（上）与执行层（下）" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="200" y="16" width="1000" height="32" as="geometry" />
    </mxCell>
    <mxCell id="sec1" value="① 一集的决策流 —— collect_episode.py 状态机。每个切换条件都是对特权真值的一次判断（代替人眼+人脑）" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#555555;align=left;" vertex="1" parent="1">
      <mxGeometry x="60" y="56" width="1240" height="26" as="geometry" />
    </mxCell>
    <mxCell id="nav" value="&lt;b&gt;1. 导航&lt;/b&gt;&amp;nbsp;&amp;nbsp;〔planner：走路〕&lt;br&gt;&lt;br&gt;• 真值算出罐子方位&lt;br&gt;• 走弧线转向 + 直行逼近&lt;br&gt;• 卡住检测：8 s 无进展 → 重新规划路线" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=left;spacing=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="60" y="92" width="300" height="180" as="geometry" />
    </mxCell>
    <mxCell id="c1" value="距罐子&lt;br&gt;XY &amp;lt; 0.65 m ?&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;→ 站定，锚定 heading，&lt;br&gt;切入手臂关节流&lt;/font&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff9e6;strokeColor=#b8962e;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="378" y="112" width="124" height="140" as="geometry" />
    </mxCell>
    <mxCell id="grasp" value="&lt;b&gt;2. 抓取&lt;/b&gt;&amp;nbsp;&amp;nbsp;〔STREAMED_MOTION：50 Hz 伺服〕&lt;br&gt;&lt;br&gt;抬手 → 下探 → 进入 → 合指 → 提起&lt;br&gt;• 进入门控：横向误差 &amp;lt; 12 mm 才许前进&lt;br&gt;• 罐子被推动 &amp;gt; 1.5 cm → 回退 5 cm 重试&lt;br&gt;• 合指：连续 3 tick 检到接触才算抓住" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8e9f3;strokeColor=#a2367e;strokeWidth=2;fontSize=13;align=left;spacing=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="520" y="92" width="300" height="180" as="geometry" />
    </mxCell>
    <mxCell id="c2" value="罐子提离桌面&lt;br&gt;&amp;gt; 6 cm ?&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;→ 真值确认抓稳，&lt;br&gt;切回 planner 走路&lt;/font&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff9e6;strokeColor=#b8962e;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="838" y="112" width="124" height="140" as="geometry" />
    </mxCell>
    <mxCell id="carry" value="&lt;b&gt;3. 搬运&lt;/b&gt;&amp;nbsp;&amp;nbsp;〔planner：走路〕&lt;br&gt;&lt;br&gt;• 手臂冻结在抓握姿态&lt;br&gt;• 走向 2.4 m 外的柜台&lt;br&gt;• heading 重锚定补偿（heading_offset）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;align=left;spacing=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="980" y="92" width="300" height="180" as="geometry" />
    </mxCell>
    <mxCell id="c3" value="距盘子 XY &amp;lt; 0.58 m ?&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;→ 再走近到 0.42 m，站定，切入手臂关节流&lt;/font&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff9e6;strokeColor=#b8962e;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="1030" y="296" width="200" height="90" as="geometry" />
    </mxCell>
    <mxCell id="place" value="&lt;b&gt;4. 放置&lt;/b&gt;&amp;nbsp;&amp;nbsp;〔STREAMED_MOTION：50 Hz 伺服〕&lt;br&gt;&lt;br&gt;• 以盘心为目标对中 ×2 轮 → 罐身竖直化&lt;br&gt;• 下放到盘面高度&lt;br&gt;• 张指 2.5 s，全程 station-keeping 防手臂回缩" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8e9f3;strokeColor=#a2367e;strokeWidth=2;fontSize=13;align=left;spacing=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="980" y="410" width="300" height="180" as="geometry" />
    </mxCell>
    <mxCell id="c4" value="手指已张开、&lt;br&gt;罐子脱手 ?&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:11px&quot;&gt;→ 后滑抽手，&lt;br&gt;切回 planner&lt;/font&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff9e6;strokeColor=#b8962e;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="838" y="430" width="124" height="140" as="geometry" />
    </mxCell>
    <mxCell id="retreat" value="&lt;b&gt;5. 撤退 + 判定&lt;/b&gt;&amp;nbsp;&amp;nbsp;〔planner + 真值〕&lt;br&gt;&lt;br&gt;• 沿背向滑出 → 抬手 → 双臂收拢 → 走开&lt;br&gt;• 用真值终审：罐子在盘上？直立（up·z ≈ 1）？&lt;br&gt;&amp;nbsp;&amp;nbsp;机器人没摔？" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=13;align=left;spacing=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="520" y="410" width="300" height="180" as="geometry" />
    </mxCell>
    <mxCell id="okbox" value="&lt;b&gt;EPISODE OK&lt;/b&gt;&lt;br&gt;发 'c' → 保存这集训练数据" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#2e7d4f;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="60" y="410" width="300" height="76" as="geometry" />
    </mxCell>
    <mxCell id="failbox" value="&lt;b&gt;EPISODE FAILED&lt;/b&gt;&lt;br&gt;发 'x' → 丢弃录制，重置场景进下一集&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#8a3835&quot;&gt;任何阶段中途失败（抓空 / 罐倒 / 摔倒 / 超时）也直接到这里&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b3403a;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="60" y="506" width="300" height="84" as="geometry" />
    </mxCell>
    <mxCell id="chan" value="方块颜色 = 控制通道：&lt;font color=&quot;#6c8ebf&quot;&gt;&lt;b&gt;蓝 = planner（下半身走路）&lt;/b&gt;&lt;/font&gt;　&lt;font color=&quot;#a2367e&quot;&gt;&lt;b&gt;紫 = STREAMED_MOTION（上半身 29 关节流）&lt;/b&gt;&lt;/font&gt;。菱形里的切换动作通过 command topic 完成；每次切回 planner 都会触发 heading 重锚定，由 heading_offset 补偿。" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=12;align=left;spacing=10;" vertex="1" parent="1">
      <mxGeometry x="410" y="620" width="870" height="64" as="geometry" />
    </mxCell>
    <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nav" target="c1"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="grasp"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="grasp" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="carry"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="carry" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="place"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="place" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#555555;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c4" target="retreat"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f9" value="全部满足" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d4f;strokeWidth=2.5;fontSize=12;fontColor=#2e7d4f;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;entryX=1;entryY=0.5;" edge="1" parent="1" source="retreat" target="okbox"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="f10" value="任一不满足" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b3403a;strokeWidth=2.5;fontSize=12;fontColor=#b3403a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="retreat" target="failbox"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="sec2" value="② 执行层 —— 决策以 ZMQ 消息落地；deploy / policy / exporter 与真人遥操作完全相同，零修改" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#555555;align=left;" vertex="1" parent="1">
      <mxGeometry x="60" y="710" width="1240" height="26" as="geometry" />
    </mxCell>
    <mxCell id="agent2" value="&lt;b&gt;脚本 Agent&lt;/b&gt;&lt;br&gt;collect_episode（决策）&lt;br&gt;stream_reach（伺服+IK）&lt;br&gt;agent_server（ZMQ 接口）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8e9f3;strokeColor=#a2367e;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="60" y="770" width="280" height="120" as="geometry" />
    </mxCell>
    <mxCell id="deploy2" value="&lt;b&gt;g1_deploy_onnx_ref&lt;/b&gt;&lt;br&gt;SONIC WBC policy&lt;br&gt;（C++，零修改）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="560" y="770" width="260" height="120" as="geometry" />
    </mxCell>
    <mxCell id="sim2" value="&lt;b&gt;MuJoCo 仿真&lt;/b&gt;&lt;br&gt;场景 + G1 物理（实时）&lt;br&gt;privileged_pub 真值 :5581&lt;br&gt;相机流 :5555" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff2e0;strokeColor=#c65a1e;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="1040" y="770" width="280" height="120" as="geometry" />
    </mxCell>
    <mxCell id="exp2" value="&lt;b&gt;data exporter&lt;/b&gt;&lt;br&gt;录制训练数据（零修改）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;spacing=8;" vertex="1" parent="1">
      <mxGeometry x="560" y="960" width="260" height="80" as="geometry" />
    </mxCell>
    <mxCell id="g1" value="ZMQ :5556（planner / pose / command）" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#a2367e;strokeWidth=2.5;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="agent2" target="deploy2"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="g2" value="DDS（domain = 实例号，多开隔离）" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;startArrow=classic;startFill=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="deploy2" target="sim2"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="g3" value=":5581 特权真值 —— 上面每个菱形判断的输入" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2e7d4f;strokeWidth=2.5;dashed=1;fontSize=12;fontColor=#2e7d4f;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="sim2" target="agent2">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="930" /><mxPoint x="200" y="930" /></Array></mxGeometry>
    </mxCell>
    <mxCell id="g4" value=":5555 图像" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="sim2" target="exp2"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="g5" value=":5580 'c' 保存 / 'x' 丢弃" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="agent2" target="exp2"><mxGeometry relative="1" as="geometry" /></mxCell>
  </root>
</mxGraphModel></diagram></mxfile>
