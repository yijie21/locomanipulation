    <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cardK" target="exporter"><mxGeometry relative="1" as="geometry" /></mxCell>
    <mxCell id="card6" value="&lt;b&gt;⑥ 状态/调试流&lt;/b&gt;&lt;br&gt;deploy 每帧的关节状态、参考位姿&lt;br&gt;+ &lt;b&gt;64 维 motion latent&lt;/b&gt;（encoder 输出）&lt;br&gt;→ 数据集列 action.motion_token [64]&lt;br&gt;（收不到时记零，注意校验）" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#eef2fb;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11.5;align=left;spacing=8;" vertex="1" parent="1">
