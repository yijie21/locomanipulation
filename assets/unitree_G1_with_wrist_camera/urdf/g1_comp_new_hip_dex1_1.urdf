      <inertia ixx="2.5583E-05" ixy="5.1557E-07" ixz="-6.3178E-07" iyy="1.4549E-05" iyz="7.8542E-08" izz="3.6013E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Dex1_finger_link_1.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.41176 0.41176 0.41176 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/dex1_col_1.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_dex1_finger_joint_1" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="right_dex1_base_link"/>
    <child link="right_dex1_finger_link_1"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.02" upper="0.0245" effort="20" velocity="0.2"/>
  </joint>
  <link name="right_dex1_finger_link_2">
    <inertial>
      <origin xyz="0.073453 0.011173 -0.0086355" rpy="0 0 0"/>
      <mass value="0.086783"/>
      <inertia ixx="2.5583E-05" ixy="-5.1557E-07" ixz="6.3178E-07" iyy="1.4549E-05" iyz="7.8542E-08" izz="3.6013E-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/Dex1_finger_link_2.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.89804 0.91765 0.92941 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/dex1_col_2.stl"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_dex1_finger_joint_2" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="right_dex1_base_link"/>
    <child link="right_dex1_finger_link_2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.02" upper="0.0245" effort="20" velocity="0.2"/>
  </joint>

  <!-- D405 wrist camera mount (right): ring clamps the 49 mm band of the Dex1 base just behind its flange, arm points to +Z of the base -->
  <joint name="right_d405_wrist_mount_joint" type="fixed">
    <origin xyz="0.027 0 0" rpy="1.5708 0 1.5708"/>
    <parent link="right_dex1_base_link"/>
    <child link="right_d405_wrist_mount_link"/>
  </joint>
  <link name="right_d405_wrist_mount_link">
    <inertial>
      <origin xyz="0 0.050 0.012" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1.2e-4" ixy="0" ixz="0" iyy="5.4e-5" iyz="0" izz="9.7e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/unitree_dex1-1_d405_wrist_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <!-- D405 body (meshes/d405.stl from realsense-ros, Apache-2.0). Back face sits on the mount's 30 deg tilted
         plate with its two M3 holes on the plate holes; mesh origin is the front-plate centre, z = optical axis. -->
    <visual>
      <origin xyz="0 0.05813 0.02952" rpy="0.5236 0 0"/>
      <geometry>
        <mesh filename="meshes/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.010"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0.06463 0.01826" rpy="0.5236 0 0"/>
      <geometry>
        <box size="0.042 0.042 0.026"/>
      </geometry>
    </collision>
  </link>

  <!-- d405_right_wrist = RealSense camera_link convention (left IR imager, 3.8 mm behind the glass):
       X = optical axis (towards the fingertips, tilted 30 deg towards the gripper axis), Y = left, Z = up -->
  <link name="d405_right_wrist_link"></link>
  <joint name="d405_right_wrist_joint" type="fixed">
    <origin xyz="0.009 0.06003 0.02623" rpy="0 -1.0472 -1.5708"/>
    <parent link="right_d405_wrist_mount_link"/>
    <child link="d405_right_wrist_link"/>
  </joint>


  <!-- servo cam -->
  <joint name="head_servo_joint" type="fixed">
    <origin xyz="0.0039635 0 -0.047" rpy="0 0 0"/>
