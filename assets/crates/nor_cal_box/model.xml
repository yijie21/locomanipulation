<!-- Cardboard moving box (NOR-CAL), the second bimanual carry target (2026-09-22).
     Same authoring as blue_crate/model.xml: body "object" with its origin at the box CENTRE,
     five thin collision boxes (1 cm walls, 0.45 x 0.32 x 0.33 m outer) carrying the mass, and
     the logistics-room visual mesh offset to the bottom. The 30 MB visual/nor_cal_box.obj is NOT tracked:
     copy it from outputs/scene/logistics_mujoco/mesh/nor_cal_box.obj before building the scene.
     Wall/contact parameters copied from the logistics room scene. -->
<mujoco model="nor_cal_box">
  <asset>
    <material name="nor_cal_cardboard" rgba="0.86 0.78 0.62 1" specular="0.05" shininess="0.05"/>
    <mesh name="nor_cal_box_vis" file="visual/nor_cal_box.obj"/>
  </asset>
  <default>
    <default class="box_col">
      <geom type="box" group="0" rgba="0.86 0.78 0.62 0" friction="1.4 0.02 0.001" solref="0.002" solimp="0.998 0.998"/>
    </default>
  </default>
  <worldbody>
    <body name="object">
      <geom type="mesh" mesh="nor_cal_box_vis" material="nor_cal_cardboard" pos="0 0 -0.165"
            contype="0" conaffinity="0" group="1" density="0"/>
      <geom class="box_col" pos="0 0 -0.160" size="0.225 0.16 0.005" mass="0.30"/>
      <geom class="box_col" pos="0.22 0 0" size="0.005 0.16 0.165" mass="0.225"/>
      <geom class="box_col" pos="-0.22 0 0" size="0.005 0.16 0.165" mass="0.225"/>
      <geom class="box_col" pos="0 0.155 0" size="0.225 0.005 0.165" mass="0.225"/>
      <geom class="box_col" pos="0 -0.155 0" size="0.225 0.005 0.165" mass="0.225"/>
    </body>
  </worldbody>
</mujoco>
