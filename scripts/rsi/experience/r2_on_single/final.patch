+        k = da * db < 0
+        pts.append(a[k] + (da[k] / (da[k] - db[k]))[:, None] * (b[k] - a[k]))
+    s = np.concatenate(pts)[:, :2] @ np.asarray(across, float)[:2]
+    return float(s.max() - s.min()) if len(s) else 0.0
