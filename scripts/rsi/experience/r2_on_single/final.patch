+    ctx = SimpleNamespace(world=world, task=SimpleNamespace(goal=goal), motor=SimpleNamespace(t=1.0), log=[])
+    ctx.note = lambda name, out, **kw: (ctx.log.append(dict(step=name, ok=out.ok, why=out.why)), out)[1]
+    return ctx
