+        now = R.quat_wxyz(tip @ R.rot_z(1.1) @ rest)
+        np.testing.assert_allclose(clearance.up_axis(now, R.quat_wxyz(rest)), tip @ [0.0, 0.0, 1.0], atol=1e-9)
+        self.assertAlmostEqual(clearance.lean_deg(now, R.quat_wxyz(rest)), 10.0)
