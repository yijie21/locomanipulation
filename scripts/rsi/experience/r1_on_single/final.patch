+@contextlib.contextmanager
+def _carry_turns(m):
+    """The motor's in-place turns at CARRY_TURN_RATE inside, its own config restored after."""
+    cfg0 = m.cfg
+    m.cfg = dataclasses.replace(cfg0, turn_rate=CARRY_TURN_RATE)
+    try:
+        yield
+    finally:
+        m.cfg = cfg0
