        <mxCell id="P2" value="P2  复位与出生 (run_round 开头, grasp_gym.py:296-357) — 站位阶段失败可整局重来 1 次" style="swimlane;html=1;startSize=30;fillColor=#f7fcf5;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
