        <mxCell id="P5" value="P5  抓取前的门与规划 (grasp_gym.py:516-591)" style="swimlane;html=1;startSize=30;fillColor=#f5fbfc;strokeColor=#10739e;fontSize=14;fontStyle=1" vertex="1" parent="1">
