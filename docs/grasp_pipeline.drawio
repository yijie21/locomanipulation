        <mxCell id="F1" value="门 1 — 罐子没被碰倒 (toppled)&#10;门 2 — ego 相机: |fx| ≤ 0.8 且 |fy| ≤ 0.9 (相机下俯 52°, 近处罐子偏低)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="P5">
