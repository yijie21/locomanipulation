        <mxCell id="C0" value="第 2 局起 (或站位重试时) 先重启 deploy: restart_deploy.sh, 清 heading_offset=0, 等 4s 引擎懒加载" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="P2">
