        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;html=1" edge="1" parent="P0" source="A3" target="A4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="P1" value="P1  每局采样 (main 循环, grasp_gym.py:206-260)" style="swimlane;html=1;startSize=30;fillColor=#fbf8ff;strokeColor=#9673a6;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="20" y="556" width="960" height="330" as="geometry" />
        </mxCell>
        <mxCell id="B1" value="最多 500 次拒绝采样, 每次抽:&#10;· 罐位: 贴最近桌沿内 4~8cm (CAN_INBOARD), 沿边方向 ±10cm; 世界 yaw 均匀随机&#10;· rel: 从 P0 的 aim cell 里等概率抽一个&#10;· 朝向 psi: 桌沿内法线 ± 25° (0.44 rad)&#10;· stand = can_xy − R(psi)·rel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8" vertex="1" parent="P1">
          <mxGeometry x="40" y="45" width="880" height="95" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="接受条件 1 — 站位离桌沿:  edge_lo ≤ edge_dist(stand) ≤ EDGE_MAX(0.32)&#10;edge_lo = EDGE_MIN(0.17) + 0.03 (前 300 次要 3cm 裕量, 之后退回裸下限)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="P1">
