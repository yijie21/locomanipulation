        <mxCell id="P3" value="P3  两段式到位 (grasp_gym.py:369-420)" style="swimlane;html=1;startSize=30;fillColor=#fffdf5;strokeColor=#d6b656;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="20" y="1386" width="960" height="330" as="geometry" />
        </mxCell>
        <mxCell id="D1" value="动量段: walk_to(stand − 0.30·fv, stop_dist 0.06, face_target=False, timeout 10+8·spawn_off)&#10;锁定采样朝向 — 目标近时 face_target 会跟着噪声方向把机器人在停步瞬间甩 110~160°" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="P3">
          <mxGeometry x="40" y="45" width="880" height="50" as="geometry" />
        </mxCell>
        <mxCell id="D2" value="IDLE 2s — 等减速滑行 (walk_to 返回后仍有 0.03~0.34m 惯性位移) 走完" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="P3">
          <mxGeometry x="40" y="105" width="880" height="40" as="geometry" />
        </mxCell>
        <mxCell id="D3" value="deadband 爬行 (≤12s, 50Hz): SLOW_WALK, movement=fv, speed=0.30 (实测仅 ~0.05 m/s, 近零动量)&#10;每 tick 用 rel_now(s) 读实时罐深, EMA 估逼近速度 v_est; 刹车提前量 lead = clip(1.2·v_est, 0.02, 0.20)&#10;停止条件: rel_x ≤ plan_r + lead  或  edge_dist ≤ EDGE_MIN&#10;→ IDLE 1.5s 定住, 打印 post-crawl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8" vertex="1" parent="P3">
          <mxGeometry x="40" y="155" width="880" height="90" as="geometry" />
        </mxCell>
        <mxCell id="DF" value="爬行中摔倒 → [stand] fell during the crawl-in (站位重试)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="P3">
          <mxGeometry x="520" y="260" width="400" height="35" as="geometry" />
