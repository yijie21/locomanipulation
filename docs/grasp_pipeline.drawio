        <mxCell id="B3" value="接受条件 2 — 整条行走线离桌沿: spawn = stand − spawn_off(0.60)·fv, 沿 spawn→stand 每 0.25m 采一点, 全部 ≥ EDGE_MIN" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="P1">
          <mxGeometry x="150" y="240" width="660" height="70" as="geometry" />
        </mxCell>
