        <mxCell id="C3" value="start_control → IDLE 4s (facing=fv 全程显式给, 否则默认朝向世界 +x 会把机器人转掉 50~70°)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="P2">
          <mxGeometry x="40" y="195" width="880" height="40" as="geometry" />
        </mxCell>
        <mxCell id="C4" value="两道出生检查: 未摔倒 ∧ 落点距 spawn ≤ 0.30m" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="P2">
          <mxGeometry x="230" y="245" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="C5" value="reanchor(): 0.3s streamed 开合, 把 deploy 的 planner heading 锚定在当前 yaw&#10;→ 切 FROZEN_UPPER_BODY, tuck_arms() 设 READY 腕位, pin_arms(READY) 锁住双臂, IDLE 2s, 开始录像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="P2">
