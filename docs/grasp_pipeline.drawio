        </mxCell>
        <mxCell id="C1" value="静默 deploy: stream_mode=VR_3PT, upper_body=None, (已在跑则) IDLE 1s — 让复位继承『站着不动』的意图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="P2">
          <mxGeometry x="40" y="95" width="880" height="40" as="geometry" />
        </mxCell>
        <mxCell id="C2" value="teleport: reset(objects={can: dxy + 随机 yaw}, robot={dxy=spawn−robot_nom, yaw=psi}) + 释放 arm pin + 收回 ghost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=8" vertex="1" parent="P2">
