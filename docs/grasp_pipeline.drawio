        <mxCell id="P4" value="P4  站位验收环 (最多 3 轮, grasp_gym.py:445-514)" style="swimlane;html=1;startSize=30;fillColor=#fdf7f7;strokeColor=#b85450;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="20" y="1746" width="960" height="560" as="geometry" />
        </mxCell>
        <mxCell id="E1" value="三项判据 (任一不满足则修正):&#10;bad_edge  : edge_dist &lt; EDGE_MIN − 0.03  (= 0.14)&#10;bad_map   : rel 不在 envelope 内  或  |方位角| &gt; 45° (超过 45° 相机会丢目标)&#10;too_deep  : rel_x &gt; plan_r + 0.06" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10" vertex="1" parent="P4">
          <mxGeometry x="150" y="45" width="660" height="120" as="geometry" />
        </mxCell>
        <mxCell id="E2" value="仅 too_deep → 前进 depth trim&#10;step = min(rel_x − plan_r, edge_dist − EDGE_MIN)&#10;step ≤ 0.02 则直接接受; 否则 walk_to(+step·fv, stop 0.03, 朝向锁定) + IDLE 0.8s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="P4">
          <mxGeometry x="30" y="200" width="410" height="105" as="geometry" />
        </mxCell>
        <mxCell id="E3" value="其余 (太近 / 出界 / 方位偏) → 整段重走&#10;stand_from(s): 用实测罐位+yaw 反解站点, 沿 fv 后移 clamp 到 edge ≥ EDGE_MIN+0.02&#10;① 退到 stand2 − 0.45·fv (stop 0.06) + IDLE 2s&#10;② 重新反解 stand2, 走到 stand2 − 0.18·fv (贴桌起步的滑行约 20cm)&#10;③ 1s facing 保持&#10;(不用 5~15cm 微步: SONIC 上双峰不可控, 小的原地不动, 大的过冲 2~3 倍)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=8" vertex="1" parent="P4">
          <mxGeometry x="480" y="200" width="450" height="145" as="geometry" />
        </mxCell>
        <mxCell id="E4" value="3 轮后的硬地板: edge_dist ≥ EDGE_MIN − 0.03 且 rel 在 envelope 内" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00" vertex="1" parent="P4">
          <mxGeometry x="190" y="380" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="EF" value="[stand] could not hold the edge clearance / arrival left the object out of reach → 站位重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450" vertex="1" parent="P4">
          <mxGeometry x="290" y="480" width="580" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ee1" value="仅深度超" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5" edge="1" parent="P4" source="E1" target="E2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ee2" value="其余违规" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5" edge="1" parent="P4" source="E1" target="E3"><mxGeometry relative="1" as="geometry" /></mxCell>
