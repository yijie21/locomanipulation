%% 抓取全流程 — 与代码一比一 (2026-08-21, HAND=dex1)
%% 权威版本是 docs/grasp_pipeline.drawio (含每一步的常量与源码行号); 本文件是它的简版
flowchart TD
  A["P0 进程启动: 载入 reach_map_dex1.npz (坐标=抓取中心) → plan_core_stand 联合求解<br/>下蹲量与站位 → rel≈(0.31,−0.11), drop 0.10, squat_hint; 标定名义出生点"]
  B["P1 采样 (≤500 次拒绝采样): 罐位贴桌沿内 4~8cm, 朝向=内法线±25°,<br/>站位 edge∈[0.20, 0.32], 且 spawn(退后 0.60m)→stand 整条线 edge ≥ 0.17"]
  C["P2 复位: 重启 deploy → 静默 → teleport → IDLE 4s → 落点检查 →<br/>reanchor → FROZEN_UPPER + pin READY → 开始录像"]
  D["P3 两段到位: 锁向 walk_to(stand−0.30·fv) → IDLE 2s 等滑行 →<br/>deadband 爬行 (speed 0.30 ≈ 0.05m/s), 刹车提前量 = 1.2s × 实测逼近速度"]
  E{"P4 验收 (≤3 轮): edge ≥ 0.14 ∧ envelope 内 ∧ 方位 ≤ 45° ∧ rel_x ≤ plan_r+0.06"}
  E2["仅过深 → 一步前进 depth trim"]
  E3["其余 → 退 0.45m 按实测罐位反解站点重走 (−0.18 偏置)"]
  F{"P5 门: 罐未倒 ∧ ego 相机 |fx|≤0.8, |fy|≤0.9"}
  G["P6 streamed 抓取: start() 交接 (0.7s 空窗 = 已知抽搐) → squat(track=True) 下蹲,<br/>掌位由实时 IK 钉住 → 50Hz 伺服 up→down→in→close→lift<br/>(entry=palm +x, SAFE_GAP 0.17, 对齐硬门 1.8cm, z 地板 = 桌面+3cm, 闭合 2s 斜坡, 抬升 0.20m)"]
  H["P7 抓稳后: 可见性 ≥70% → stand_up + carry_pose → 锁向后退 0.35m (两步) →<br/>IDLE 2s → 掌系漂移 <3cm ∧ 罐高于桌面+3cm"]
  OK["EPISODE OK"]
  FAIL["EPISODE FAILED [stand|view|grasp|hold|gym]"]
  A --> B --> C --> D --> E
  E -- 仅深度超 --> E2 --> E
  E -- 太近/出界/方位偏 --> E3 --> E
  E -- 通过 --> F -- 通过 --> G --> H --> OK
  E -. 3 轮仍不合格 .-> FAIL
  F -. 否 .-> FAIL
  G -. 摔倒/罐倒/推移/超时 .-> FAIL
  H -. 滑脱 .-> FAIL
  FAIL -. "[stand] 类可整局重试 1 次" .-> C
