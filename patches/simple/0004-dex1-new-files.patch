+# Copyright (c) 2025-2026 The SIMPLE Authors + locomanipulation project
+# SPDX-License-Identifier: MIT
+"""HugContainer task variant on the dex1-gripper G1 (locomanipulation robot).
+
+Identical scene/DR/success logic to the teleop original -- the only change is
+the robot: dex1 parallel gripper + head/wrist cameras, assets from the
+locomanipulation tree (see robots/g1_sonic_dex1.py)."""
+
+from __future__ import annotations
+
+from typing import Any
+
+from simple.tasks.registry import TaskRegistry
+from simple.tasks.g1_wholebody_pick_and_place_and_hug_container_teleop import (
+    G1WholebodyPickAndPlaceAndHugContainerTaskTeleop,
+)
+import simple.robots.g1_sonic_dex1  # noqa: F401  (registers the robot uid)
+
+
+@TaskRegistry.register("g1_wholebody_pick_and_place_and_hug_container_dex1")
+class G1WholebodyPickAndPlaceAndHugContainerTaskDex1(
+        G1WholebodyPickAndPlaceAndHugContainerTaskTeleop):
+    uid: str = "g1_wholebody_pick_and_place_and_hug_container_dex1"
+    label: str = "G1 TELEOP PickPlace+HugContainer (dex1)"
+
+    robot_cfg: dict[str, Any] = dict(
+        uid="g1_sonic_dex1",
+    )
+
+    def __init__(self, *args, robot_uid: str = "g1_sonic_dex1", **kwargs):
+        # The parent __init__ force-updates robot_cfg from its robot_uid
+        # parameter (default "g1_sonic"), so the class attribute alone is
+        # not enough -- the default has to change here.
+        super().__init__(*args, robot_uid=robot_uid, **kwargs)
