+    def _flush_priv_seqs(self, discarded: bool) -> None:
+        """teleop_free: write this episode's per-row privileged seq numbers.
+
+        One JSON per episode under <save_root>/priv_seq/, keyed by the
+        episode index the buffer holds RIGHT NOW (save_episode advances it),
+        plus the discard flag so downstream joins can skip discarded ones
+        the same way they already skip discarded episodes.
+        """
+        import json as _json
+        import os as _os
+        try:
+            rows = getattr(self, "_row_priv_seqs", None)
+            if rows is None:
+                return
+            root = str(getattr(self.data_exporter.meta, "root", "."))
+            d = _os.path.join(root, "priv_seq")
+            _os.makedirs(d, exist_ok=True)
+            idx = int(self.current_episode_index)
+            with open(_os.path.join(d, f"episode_{idx:06d}.json"), "w") as f:
+                _json.dump({"episode_index": idx, "discarded": bool(discarded),
+                            "n_rows": len(rows), "priv_seq": rows}, f)
+            self._row_priv_seqs = []
+        except Exception as e:  # noqa: BLE001 -- a sidecar must never cost an episode
+            print(f"[priv-seq] sidecar write failed (episode unaffected): {e}")
+
+    def _add_object_poses(self, frame_data: dict) -> None:
+        """teleop_free: pelvis-frame 6D poses (pos3 + rot6d) of task objects.
+
+        Pose of object o in the pelvis frame: p = R_pelvis^T (p_o - p_pelvis),
+        q = q_pelvis^-1 * q_o, stored as pos3 + quat_to_rot6d(q) so the rot6d
+        convention matches every other rotation in this dataset.  Zeros until
+        the first privileged message arrives.
+        """
+        if getattr(self, "_priv_socket", None) is not None:
+            try:
+                while True:
+                    self._latest_priv = json.loads(
+                        self._priv_socket.recv_string(zmq.NOBLOCK))
+            except zmq.Again:
+                pass
+        s = self._latest_priv
+        # teleop_free: remember WHICH privileged message this row used. The
+        # stream is CONFLATEd, so without this there is no shared key between
+        # parquet rows and the sim-side pose record -- alignment was proven
+        # structurally impossible without it. One int per row, flushed as an
+        # episode-level sidecar (LeRobot schema untouched).
+        if not hasattr(self, "_row_priv_seqs"):
+            self._row_priv_seqs = []
+        self._row_priv_seqs.append(None if s is None else s.get("seq"))
+        for key in _pose_objects():
+            out = np.zeros(9, dtype=np.float32)
+            if s is not None and key not in s.get("objects", {}):
+                # Say so ONCE per key. Silence here is how a bottle_only scene
+                # recorded 1008 rows of can_pose = 0.0: the writer asked the
+                # privileged stream for an object the scene no longer had, got
+                # nothing, and wrote zeros -- which every downstream check then
+                # reads as "the object never moved".
+                seen = self.__dict__.setdefault("_pose_missing_warned", set())
+                if key not in seen:
+                    seen.add(key)
+                    print(f"[object-pose] {key!r} is not in the privileged "
+                          f"stream (it has {sorted(s.get('objects', {}))}); "
+                          f"observation.{key}_pose will be all zeros. Set "
+                          f"TF_POSE_OBJECTS to the scene's own objects.")
+            if s is not None and key in s.get("objects", {}):
+                pw, xw, yw, zw = s["pelvis"]["quat"]
+                Rp = np.array([
+                    [1 - 2 * (yw * yw + zw * zw), 2 * (xw * yw - pw * zw), 2 * (xw * zw + pw * yw)],
+                    [2 * (xw * yw + pw * zw), 1 - 2 * (xw * xw + zw * zw), 2 * (yw * zw - pw * xw)],
+                    [2 * (xw * zw - pw * yw), 2 * (yw * zw + pw * xw), 1 - 2 * (xw * xw + yw * yw)],
+                ])
+                dp = np.asarray(s["objects"][key]["pos"]) - np.asarray(s["pelvis"]["pos"])
+                out[0:3] = Rp.T @ dp
+                ow, ox, oy, oz = s["objects"][key]["quat"]
+                q_rel = np.array([
+                    pw * ow + xw * ox + yw * oy + zw * oz,
+                    pw * ox - xw * ow - yw * oz + zw * oy,
+                    pw * oy + xw * oz - yw * ow - zw * ox,
+                    pw * oz - xw * oy + yw * ox - zw * ow,
+                ])
+                out[3:9] = np.asarray(quat_to_rot6d(q_rel), dtype=np.float32).reshape(-1)
+            frame_data[f"observation.{key}_pose"] = out
+
