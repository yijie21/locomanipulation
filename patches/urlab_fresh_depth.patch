+bool UMjCamera::RenderDepthNow()
+{
+	check(IsInGameThread());
+	if (!CaptureComponent || !RenderTarget || CaptureMode != EMjCameraMode::Real || resolution.Num() < 2)
+		return false;
+	if (!DepthCapture)
+	{
+		DepthCapture = NewObject<USceneCaptureComponent2D>(GetOwner(), NAME_None, RF_Transient);
+		DepthCapture->bCaptureEveryFrame = false;
+		DepthCapture->bCaptureOnMovement = false;
+		DepthCapture->bAlwaysPersistRenderingState = false;
+		DepthCapture->bUseRayTracingIfEnabled = false;
+		// Not hidden: CaptureScene() skips a component whose IsVisible() is false, and bHiddenInGame makes it so
+		// (USceneComponent::IsVisible); the colour capture is unhidden the same way in SetStreamingEnabled.
+		DepthCapture->bHiddenInGame = false;
+		DepthCapture->SetVisibility(true);
+		DepthCapture->CaptureSource = ESceneCaptureSource::SCS_SceneDepth;
+		DepthCapture->SetupAttachment(CaptureComponent); // zero relative transform: the colour capture's pose
+		DepthCapture->RegisterComponent();
+		// RGBA32f, depth in R: Vulkan's float readback converts R32G32B32A32_SFLOAT but not R32_SFLOAT (an assert,
+		// then SIGSEGV; ConvertRawDataToFLinearColor in VulkanRenderTarget.cpp).
+		DepthTarget = NewObject<UTextureRenderTarget2D>(this, NAME_None, RF_Transient);
+		DepthTarget->RenderTargetFormat = ETextureRenderTargetFormat::RTF_RGBA32f;
+		DepthTarget->InitCustomFormat(resolution[0], resolution[1], PF_A32B32G32R32F, /*bForceLinearGamma=*/true);
+		DepthCapture->TextureTarget = DepthTarget;
+		UE_LOG(LogURLabImport, Log, TEXT("[MjCamera] '%s' depth capture created (%dx%d)"), *MjName, resolution[0],
+			resolution[1]);
+	}
+	// The colour capture's view as it stands now (its FOV follows fovy; its hidden list is refreshed per tick).
+	DepthCapture->FOVAngle = CaptureComponent->FOVAngle;
+	DepthCapture->ProjectionType = CaptureComponent->ProjectionType;
+	DepthCapture->OrthoWidth = CaptureComponent->OrthoWidth;
+	DepthCapture->bOverride_CustomNearClippingPlane = CaptureComponent->bOverride_CustomNearClippingPlane;
+	DepthCapture->CustomNearClippingPlane = CaptureComponent->CustomNearClippingPlane;
+	DepthCapture->MaxViewDistanceOverride = CaptureComponent->MaxViewDistanceOverride;
+	DepthCapture->PrimitiveRenderMode = CaptureComponent->PrimitiveRenderMode;
+	DepthCapture->HiddenComponents = CaptureComponent->HiddenComponents;
+	DepthCapture->HiddenActors = CaptureComponent->HiddenActors;
+	DepthCapture->ShowOnlyComponents = CaptureComponent->ShowOnlyComponents;
+	DepthCapture->ShowOnlyActors = CaptureComponent->ShowOnlyActors;
+	DepthCapture->ShowFlags = CaptureComponent->ShowFlags;
+	DepthCapture->ShowFlags.SetTemporalAA(false);
+	DepthCapture->ShowFlags.SetAntiAliasing(false);
+	DepthCapture->CaptureScene();
+	return true;
+}
+
+bool UMjCamera::ReadDepthNow(TArray<float>& OutDepth)
+{
+	check(IsInGameThread());
+	FTextureRenderTargetResource* Resource = DepthTarget ? DepthTarget->GameThread_GetRenderTargetResource() : nullptr;
+	if (!Resource)
+		return false;
+	// Flushes the rendering commands, so the capture queued by RenderDepthNow is included. MinMax: the raw floats.
+	TArray<FLinearColor> Px;
+	if (!Resource->ReadLinearColorPixels(Px, FReadSurfaceDataFlags(RCM_MinMax, CubeFace_MAX)))
+		return false;
+	OutDepth.SetNumUninitialized(Px.Num());
+	for (int32 i = 0; i < Px.Num(); ++i)
+		OutDepth[i] = Px[i].R;
+	return true;
+}
+
 bool UMjCamera::IsReadbackReady() const
 {
 	return bReadbackComplete;
