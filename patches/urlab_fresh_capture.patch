+				Manager->PhysicsEngine->PushRenderState();
+			}
+			Fresh = MakeShared<FFreshCapture, ESPMode::ThreadSafe>();
+			TWeakObjectPtr<AAMjManager> WeakMgr(Manager);
+			auto Capture = [WeakMgr, FreshCams, bStream, State = Fresh]()
+			{
+				if (AAMjManager* M = WeakMgr.Get())
+					M->ApplyRenderStateNow();
+				// Every camera renders before the first readback: a readback flushes the GPU, so reading each
+				// camera right after its own capture serialises render and readback per camera.
+				TArray<UMjCamera*> Rendered;
+				for (const TWeakObjectPtr<UMjCamera>& W : FreshCams)
+				{
