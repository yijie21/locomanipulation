+// MJCF fovy is the VERTICAL field of view; USceneCaptureComponent2D::FOVAngle is HORIZONTAL. Passing fovy
+// straight through zooms every non-square camera in (640x480, fovy 73.74: 73.74 deg wide instead of 90).
+float HorizontalFovDeg(float FovyDeg, const TArray<int32>& Res)
+{
+	if (Res.Num() < 2 || Res[0] <= 0 || Res[1] <= 0)
+		return FovyDeg;
+	const float Aspect = static_cast<float>(Res[0]) / static_cast<float>(Res[1]);
+	return 2.0f * FMath::RadiansToDegrees(FMath::Atan(FMath::Tan(FMath::DegreesToRadians(FovyDeg) * 0.5f) * Aspect));
+}
