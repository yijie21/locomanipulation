+bool UMjCamera::RenderNow(bool bContinue)
+{
+	check(IsInGameThread());
+	if (!CaptureComponent || !RenderTarget || CaptureMode == EMjCameraMode::Depth)
+		return false;
+	if (!bOnDemand)
+	{
+		bOnDemand = true;
+		CaptureComponent->bCaptureEveryFrame = false;
+		// Lumen and other temporal passes need a persistent view state in a scene capture.
+		CaptureComponent->bAlwaysPersistRenderingState = true;
+		// Scene captures turn TemporalAA off (legacy default, SceneCaptureComponent.cpp), which drops the project's
+		// TSR to FXAA: hard edges and text alias. With it on, the FreshCaptureRepeats captures of the frozen world
+		// are jittered TSR samples.
+		CaptureComponent->ShowFlags.SetTemporalAA(true);
+		CaptureComponent->ShowFlags.SetAntiAliasing(true);
+	}
+	// CaptureScene sends the pending end-of-frame render updates first, so the
+	// transforms just applied from the render snapshot are what gets drawn.
+	if (bContinue)
+	{
+		CaptureComponent->bCameraCutThisFrame = false;
+		CaptureComponent->CaptureScene();
+		return true;
+	}
+	const int32 Repeats = FMath::Clamp(CVarFreshCaptureRepeats.GetValueOnGameThread(), 1, 64);
+	for (int32 i = 0; i < Repeats; ++i)
+	{
+		// The world jumped to a new pose since the last request: a camera cut on the first capture drops TSR and
+		// Lumen screen-space history, so the image holds this pose only (without it TSR ghosts the previous pose
+		// into the robot). The later captures of the frozen world accumulate jittered samples. Reset per capture.
+		CaptureComponent->bCameraCutThisFrame = (i == 0);
+		CaptureComponent->CaptureScene();
+	}
+	return true;
+}
+
+bool UMjCamera::ReadNow(TArray<FColor>& OutPixels)
+{
+	check(IsInGameThread());
+	FTextureRenderTargetResource* Resource = RenderTarget ? RenderTarget->GameThread_GetRenderTargetResource() : nullptr;
+	if (!Resource)
+		return false;
+	// ReadPixels flushes the rendering commands, so the captures queued by RenderNow are included.
+	return Resource->ReadPixels(OutPixels, FReadSurfaceDataFlags(RCM_UNorm, CubeFace_MAX));
+}
