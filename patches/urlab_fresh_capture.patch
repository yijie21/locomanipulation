+	// "stream" is the same, for a pose that continues the previous request's (a trace
+	// played at its own rate): one capture that keeps TSR / Lumen history, as a game frame.
+	struct FFreshCapture
+	{
+		TMap<UMjCamera*, TArray<FColor>> Pixels;
+		FEvent* Done = FPlatformProcess::GetSynchEventFromPool(/*bIsManualReset=*/false);
+		~FFreshCapture() { FPlatformProcess::ReturnSynchEventToPool(Done); }
+	};
+	TSharedPtr<FFreshCapture, ESPMode::ThreadSafe> Fresh;
+	{
+		TArray<TWeakObjectPtr<UMjCamera>> FreshCams;
+		bool bStream = true;
+		for (const TPair<FString, ECameraInclude>& Spec : CameraSpec)
+		{
+			UMjCamera** Found = ByName.Find(Spec.Key);
+			const bool bWant = Spec.Value == ECameraInclude::Fresh || Spec.Value == ECameraInclude::Stream;
+			if (bWant && Found && *Found && (*Found)->CaptureMode != EMjCameraMode::Depth)
