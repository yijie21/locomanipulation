# Upstream clones — each is its own git repo, tens of GB. Never tracked here.
/third_party/

# Generated data (episodes, logs, raw videos live here; curated videos go to /videos)
/outputs/
/datasets
*.log

# wandb run scratch (metrics live on wandb.ai; these are local caches that
# git add -A swept in once -- 116 files of requirements.txt and .wandb blobs)
/wandb/
third_party/**/wandb/

# Python
__pycache__/
*.pyc
.venv*/

# Session tooling
/.claude/

# agent ticket scratch (to-tickets)
.scratch/

# Converted Isaac USD caches only; shared source assets live in tracked assets/scene/.
# Rebuilt by scripts/build_isaac_assets.sh from the installed scene and tracked sources.
assets/isaac/
# Google Scanned Objects: 2 GB of meshes installed by scripts/install_gso.sh; only catalog.json, LICENSE, README and
# VERSION are tracked (2026-11-03)
assets/mujoco_scanned_objects/models/
assets/mujoco_scanned_objects/assets/
MUJOCO_LOG.TXT

# never track these paths, symlink or directory (2026-09-09 incident: a worktree symlink named outputs was committed and the merge replaced the data directory)
/outputs
/third_party

# the knowledge library as the roles read it, marked with the running incumbent's rounds (KNOWLEDGE.md; HITS.md
# before 2026-11-18), written by the scene RSI loop each iteration (scripts/rsi/knowledge.py write_hits); ignored so
# the loop's changed_files() never sees it as an Engineer's stray
scripts/rsi/knowledge/HITS.md
scripts/rsi/knowledge/KNOWLEDGE.md
